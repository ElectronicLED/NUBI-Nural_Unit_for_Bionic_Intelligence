<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="view_robot_pkg">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import view_robot_pkg urdf file -->
    <xacro:include filename="$(find view_robot_pkg)/urdf/robot_description.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="view_robot_pkg.ros2_control.xacro" />


    <xacro:view_robot_pkg_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
