<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_description_3">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import robot_description_3 urdf file -->
    <xacro:include filename="$(find view_robot_pkg)/urdf/robot_description.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="robot_description_3.ros2_control.xacro" />


    <xacro:robot_description_3_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
